//write the list of commands that can be sent to the current report to the log

Names default to here( 1 );

thisAddIn = "com.github.himanga.JMPScriptingTools";

//get or make and populate namespace for this add-in
If( 
	!Namespace Exists( Eval( thisAddIn ) || ".addinnamespace" ),
	//reload the add-in
	ns = New Namespace( Eval( thisAddIn ) || ".addinnamespace" );
	ns:addinhome = "$ADDIN_HOME(" || thisAddIn || ")\";
	Include( ns:addinhome || "addinLoad.jsl" );,
	ns = Namespace( Eval( thisAddIn ) || ".addinnamespace" )
);

ns:logusage( "Get Window Scriptable Object" );

rpt = Empty();
Try( rpt = Current Report() );
If( Is Empty( rpt ),
	ns:Refuse( "Get Window Scriptable Object", "Open a report window first, then run Get Window Scriptable Object." );
);

// Not every report answers Get Scriptable Object - keep going and still
// show what the window does support, but say so rather than silently
// skipping it.
Try(
	rpt << Get Scriptable Object,
	ns:logerror( "Get Window Scriptable Object: Get Scriptable Object failed - " || Char( exception_msg ) );
	Write( "\!NThis report does not support Get Scriptable Object; showing its properties only.\!N" );
);
ShowProperties( rpt );
