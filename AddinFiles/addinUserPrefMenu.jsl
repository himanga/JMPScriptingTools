/* About: This File
Menu entry point for Add-Ins > Scripting Tools > Preferences.

Section: Globals
*/

Names default to here( 1 );

thisAddIn = "com.github.himanga.JMPScriptingTools";

//get or make namespace for this add-in
If(
	!Namespace Exists( Eval( thisAddIn ) || ".addinnamespace" ),
	//reload the add-in - the preferences framework and its schema are set
	//up by addinLoad.jsl, so there's nothing to show without it
	ns = New Namespace( Eval( thisAddIn ) || ".addinnamespace" );
	ns:addinhome = "$ADDIN_HOME(" || thisAddIn || ")\";
	Include( ns:addinhome || "addinLoad.jsl" );,
	ns = Namespace( Eval( thisAddIn ) || ".addinnamespace" )
);

ns:logusage( "Preferences" );

ns:UserPrefUI();
