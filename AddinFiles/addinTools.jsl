/* About: Shared helper functions

Small utilities used across the add-in. Ported from the matching file in
JMPOSIPITools so the shared user-preferences framework (addinUserPref.jsl)
behaves identically in every add-in - keep the two in sync when either
changes.

Section: Globals
*/

Names default to here( 1 );

// About: Customize this file
// Set this to the add-in ID
thisAddIn = "com.github.himanga.JMPScriptingTools";

// About: get or make namespace for this add-in
If(
	!Namespace Exists( Eval( thisAddIn ) || ".addinnamespace" ),
	ns = New Namespace( Eval( thisAddIn ) || ".addinnamespace" ),
	ns = Namespace( Eval( thisAddIn ) || ".addinnamespace" )
);

/*
	Function: TryAppendError
		---Prototype---
		TryAppendError( Expr ex, List lst, String prepend, Boolean stillthrow )
		---------------
		Evaluate an expression, and on failure append a readable message to
		a list of errors instead of aborting - so a caller can collect every
		problem in a batch (e.g. loading a preferences file key by key) and
		report them together.

	Parameters:
		ex - Expression to evaluate.
		lst - Expr() of the list to append any error message to.
		prepend - Text put in front of the exception message.
		stillthrow - If 1, rethrow after recording the message.

	Returns:
		0 if the expression failed and stillthrow was 0.

	Example:
		> ns:TryAppendError( Expr( 1 = 2 ), Expr( loaderrors ), "Error loading preferences file" );
*/
ns:TryAppendError = function({ex, lst, prepend, stillthrow = 0}, {err, errm},
	lst = Name Expr(lst);
	if(!(Type(lst) == "List"), Throw("list to append error to must be a list, (was " || Type(lst) || ")"));
	if(!(Type(prepend) == "String"), Throw("prepend text must be a string, (was " || Type(prepend) || ")"));
	if(!(Contains({"Integer", "Number"}, Type(stillthrow) )), Throw("stillthrow must be an integer of 0 or 1, (was " || Type(stillthrow) || ")"));
	if(!(Contains({0,1}, stillthrow)), Throw("stillthrow must be 0 or 1"));
	Try(
		Eval(Name Expr(ex));
	,
		err = exception_msg;
		if(is list(err),
			errm = prepend || ": " || char(err[1]),
			errm = prepend || ": " || char(err);
		);
		Print(errm);
		Eval(Eval Expr(Insert Into(Expr(name expr(lst)), errm)));
		if(stillthrow == 1, Throw(errm), Return(0));
	)
);

/*
	Function: AutoResizeTEB
		---Prototype---
		AutoResizeTEB( TextEditBox teb )
		---------------
		Resize a text edit box's height to fit the number of lines it
		currently holds, so multi-line preference values aren't clipped.

	Parameters:
		teb - The Text Edit Box display box to resize.

	Example:
		> ns:AutoResizeTEB( myTextEditBox );
*/
ns:AutoResizeTEB = function({teb},
	t = teb << get text;
	breakcount = length(t) - length(substitute(t,"\!N",""));
	fs = teb << get font size;
	tHeight = (breakcount + 1) * ( fs ) * 0.89 + fs * 1.06;
	teb << set height(tHeight + 2);
);

/*
	Function: Refuse
		---Prototype---
		Refuse( String action, String message )
		---------------
		Tell the user why a command will not run, then stop it. Shows the
		message in a window - a bare Throw() only reaches the JMP log,
		which nobody has open when they pick a menu item - logs it at Warn,
		and then halts the calling script.

	Parameters:
		action - Menu caption of the calling command, used in the window
			title and the log entry.
		message - What the user needs to do, in plain language.

	Returns:
		Never returns - always throws.

	Example:
		> ns:Refuse( "Rename Columns", "Open a data table first." );
*/
ns:Refuse = Function( {action, message}, {},
	ns:logwarn( action || ": " || message );
	New Window( action,
		<< Modal,
		V List Box(
			Text Box( message, << Set Width( 380 ), << Set Wrap( 380 ) ),
			Spacer Box( Size( 0, 16 ) ),
			Button Box( "OK" ),
			<< Padding( Left( 20 ), Top( 20 ), Right( 20 ), Bottom( 20 ) )
		)
	);
	// Stops the calling script. No argument, so the user gets the window
	// above and not a second, more cryptic message behind it.
	Throw();
);

/*
	Function: RequireDataTable
		---Prototype---
		RequireDataTable( String action )
		---------------
		Return the current data table, or stop with a message the user can
		act on. Every command here needs an open table; without this each
		one fails somewhere further in with a raw JMP error naming an
		internal variable.

	Parameters:
		action - Menu caption of the calling command, used in the message
			and the log entry.

	Returns:
		The current data table. Throws if there is not one.

	Example:
		> dt = ns:RequireDataTable( "Rename Columns" );
*/
ns:RequireDataTable = Function( {action}, {dt},
	dt = Empty();
	Try( dt = Current Data Table() );
	If( Is Empty( dt ),
		ns:Refuse( action, "Open a data table first, then run " || action || "." );
	);
	dt;
);

/*
	Function: RequireSelectedColumns
		---Prototype---
		RequireSelectedColumns( DataTable dt, String action )
		---------------
		Return the table's selected columns, or stop with a message the
		user can act on.

	Parameters:
		dt - Data table to read the selection from.
		action - Menu caption of the calling command.

	Returns:
		List of selected columns. Throws if the selection is empty.

	Example:
		> cols = ns:RequireSelectedColumns( dt, "Copy Column Script" );
*/
ns:RequireSelectedColumns = Function( {dt, action}, {cols},
	cols = dt << Get Selected Columns();
	If( N Items( cols ) < 1,
		ns:Refuse( action, "Select one or more columns first, then run " || action || "." );
	);
	cols;
);
